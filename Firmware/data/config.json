{
  "device_profile": "AIROWL",
  "hardware": {
    "firmwareVersion": "3.0.0",
    "display": "ST7789_240x320",
    "touch_controller": "CST816S"
  },
  "sensors": [
    {
      "type": "aht20",
      "enabled": false,
      "read_interval": 10000,
      "publish_interval": 120000
    },
    {
      "type": "pms",
      "enabled": false,
      "read_interval": 1000,
      "publish_interval": 60000
    },
    {
      "type": "pm700",
      "enabled": true,
      "read_interval": 1000,
      "publish_interval": 60000
    }
  ],
  "services": {
    "wifi": {
      "enabled": true,
      "ap_timeout": 120000
    },
    "mqtt": {
      "enabled": true,
      "server": "mqtt.oizom.com",
      "username": "oizom",
      "password" : "12345678"
    },
    "ota": {
      "enabled": true,
      "versionURL" : "http://socket.oizom.com/airowl/latest",
      "firmwareURL" :"http://socket.oizom.com/airowl/firmware.bin"
    },
    "matter": {
      "enabled": true
    }
  }
}
