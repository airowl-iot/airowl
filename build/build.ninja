build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/upeya/esp/esp-idf/examples/AirOwl_Code_Conversion/air_owl_firmware/build && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/upeya/esp/esp-idf/examples/AirOwl_Code_Conversion/air_owl_firmware/build && /usr/bin/cmake --regenerate-during-build -S/home/upeya/esp/esp-idf/examples/AirOwl_Code_Conversion/air_owl_firmware -B/home/upeya/esp/esp-idf/examples/AirOwl_Code_Conversion/air_owl_firmware/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build list_install_components: phony


#############################################
# Utility command for install

build CMakeFiles/install.util: CUSTOM_COMMAND all
  COMMAND = cd /home/upeya/esp/esp-idf/examples/AirOwl_Code_Conversion/air_owl_firmware/build && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
