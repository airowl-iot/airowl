build esp-idf/display_manager/libdisplay_manager.a: C_STATIC_LIBRARY_LINKER____idf_display_manager_ esp-idf/display_manager/CMakeFiles/__idf_display_manager.dir/display_manager.c.obj || esp-idf/esp_lcd/libesp_lcd.a esp-idf/espressif__esp32-camera/libespressif__esp32-camera.a esp-idf/espressif__esp_codec_dev/libespressif__esp_codec_dev.a esp-idf/espressif__esp_lcd_ili9341/libespressif__esp_lcd_ili9341.a esp-idf/espressif__esp_lcd_touch/libespressif__esp_lcd_touch.a esp-idf/espressif__esp_lcd_touch_ft5x06/libespressif__esp_lcd_touch_ft5x06.a esp-idf/espressif__esp_lvgl_port/liblvgl_port_lib.a esp-idf/espressif__m5stack_core_s3/libespressif__m5stack_core_s3.a esp-idf/fatfs/libfatfs.a esp-idf/json/libjson.a esp-idf/lvgl/liblvgl.a esp-idf/sdmmc/libsdmmc.a esp-idf/spiffs/libspiffs.a esp-idf/wear_levelling/libwear_levelling.a esp-idf/xtensa/libxtensa.a
  LANGUAGE_COMPILE_FLAGS = -mlongcalls  -fno-builtin-memcpy -fno-builtin-memset -fno-builtin-bzero -fno-builtin-stpcpy -fno-builtin-strncpy
  OBJECT_DIR = esp-idf/display_manager/CMakeFiles/__idf_display_manager.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = esp-idf/display_manager/libdisplay_manager.a
  TARGET_PDB = display_manager.a.dbg


#############################################
# Utility command for edit_cache

build esp-idf/display_manager/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/upeya/esp/esp-idf/examples/AirOwl_Code_Conversion/air_owl_firmware/build/esp-idf/display_manager && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

